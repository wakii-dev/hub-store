# Dev-only environment — committed intentionally (dev secret is NOT a production secret)
JWT_DEV_SECRET=7bff9f47ad0a956f70e92cf82da0b069ed9271f33cc31ea16163837ef6e49624

# Dev port map
PORT_BFF=8080
PORT_SHELL=3000
PORT_ORDERS=3001
PORT_FULFILLMENT=3002
GRPC_FULFILLMENT=50051
GRPC_BATCHING=50052
GRPC_PRINT=50053

# FE (Vite) — legacy fake-JWT dev secret (fake-jwt giờ chỉ còn cho unit test
# mock; compose vẫn yêu cầu JWT_DEV_SECRET nên giữ ở đây)
VITE_JWT_DEV_SECRET=7bff9f47ad0a956f70e92cf82da0b069ed9271f33cc31ea16163837ef6e49624

# OIDC (SF-4) — shell login Keycloak PKCE; realm `hubstore` (path /realms/hubstore
# derive trong code). Keycloak chạy qua `docker compose up -d keycloak` (:8081).
VITE_OIDC_AUTHORITY=http://localhost:8081
VITE_OIDC_CLIENT_ID=hubstore-web
VITE_OIDC_REDIRECT_URI=http://localhost:3000/callback

# BFF verify (SF-4) — issuer BASE (code derive /realms/hubstore); host view
# (compose bff override OIDC_JWKS_URL thành http://keycloak:8081 trong network)
OIDC_ISSUER=http://localhost:8081
OIDC_AUDIENCE=hubstore-api
OIDC_JWKS_URL=http://localhost:8081

# DEV-ONLY — bật /auth/reset-password trên BFF (không xác minh danh tính; prod KHÔNG set)
ENABLE_DEV_RESET_PASSWORD=1

# Users mẫu (realm import): coordinator / warehouse / manager — password Password123! (dev-only)
POSTGRES_PASSWORD=c477561ba29974f8f0a6cf9c34155112
