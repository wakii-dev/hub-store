  "clientScopes": [
    {
      "name": "roles",
      "description": "OpenID Connect scope for add user roles to the access token (explicit: id.token.claim true — import mặc định bỏ setting này nên ID token thiếu realm_access)",
      "protocol": "openid-connect",
