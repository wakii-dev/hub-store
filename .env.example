# Copy sang .env (hoặc append vào .env hiện có) — điền giá trị local.
# LƯU Ý: KHÔNG commit POSTGRES_PASSWORD/KEYCLOAK_ADMIN_PASSWORD vào .env
# git-tracked — dev secret là local-only (xem README mục "Postgres infra + seed").
JWT_DEV_SECRET=7bff9f47ad0a956f70e92cf82da0b069ed9271f33cc31ea16163837ef6e49624

# Dev port map
PORT_BFF=8080
PORT_SHELL=3000
PORT_ORDERS=3001
PORT_FULFILLMENT=3002
GRPC_FULFILLMENT=50051
GRPC_BATCHING=50052
GRPC_PRINT=50053

# FE (Vite) — legacy fake-JWT dev secret (SF-4: fake-jwt chỉ còn cho unit test
# mock; compose vẫn yêu cầu JWT_DEV_SECRET nên giữ)
VITE_JWT_DEV_SECRET=7bff9f47ad0a956f70e92cf82da0b069ed9271f33cc31ea16163837ef6e49624

# --- OIDC shell login (SF-4) — giá trị dev local; realm `hubstore` ---
# VITE_OIDC_AUTHORITY=http://localhost:8081
# VITE_OIDC_CLIENT_ID=hubstore-web
# VITE_OIDC_REDIRECT_URI=http://localhost:3000/callback

# --- Postgres (FI-245 SF-1) ---
POSTGRES_USER=hubstore
POSTGRES_PASSWORD=           # BẮT BUỘC — compose fail-loud (:? pattern) nếu rỗng; tự điền local, KHÔNG commit

# Contract cho app services (compose wire sẵn — giữ ở đây làm tham chiếu SF-2/SF-3/SF-4):
# FULFILLMENT_DB_HOST=postgres / PORT=5432 / NAME=fulfillment / USER=$POSTGRES_USER / PASSWORD=$POSTGRES_PASSWORD
# BATCHING_DB_HOST=postgres    / PORT=5432 / NAME=batching    / USER=$POSTGRES_USER / PASSWORD=$POSTGRES_PASSWORD
# SF-7 (FI-252): bff cũng dùng chung FULFILLMENT_DB_* ở trên (audit trail ghi
# activity_log trực tiếp DB fulfillment) — compose wire sẵn, không cần env thêm.

# --- OIDC (BFF verify — SF-4 sở hữu realm; SF-1 wire env) ---
OIDC_ISSUER=http://localhost:8081   # base — code derive /realms/hubstore (claim iss)
OIDC_AUDIENCE=hubstore-api
OIDC_JWKS_URL=http://localhost:8081 # host view cho dev-run; compose bff override http://keycloak:8081 (trong network)

# DEV-ONLY — bật /auth/reset-password trên BFF (không xác minh danh tính).
# Fail-safe: KHÔNG set → endpoint không tồn tại (404). Prod KHÔNG BAO GIỜ set.
ENABLE_DEV_RESET_PASSWORD=1

# --- Keycloak (SF-4) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=    # compose có dev default "admin" — muốn khác thì điền local, KHÔNG commit

# --- Users management (SF-8) — Keycloak Admin API service-account client ---
# Client `hubstore-admin` trong realm JSON (serviceAccountsEnabled, role
# realm-management:manage-users). Dev default khớp realm JSON literal —
# production: secret riêng, KHÔNG commit.
KC_ADMIN_CLIENT_ID=hubstore-admin
KC_ADMIN_CLIENT_SECRET=hubstore-admin-dev-secret

# --- Ahamove adapter (SF-15 — batching-service dual-mode) ---
# Mặc định KHÔNG set gì = mock mode (in-memory, không gọi partner thật).
# AHAMOVE_MODE=mock | real — "real" YÊU CẦU đã điền API_KEY + PARTNER_TOKEN.
#AHAMOVE_MODE=mock
#AHAMOVE_API_KEY=           # bearer token Ahamove (real mode) — local-only, KHÔNG commit
#AHAMOVE_PARTNER_TOKEN=     # partner token Ahamove (real mode) — local-only, KHÔNG commit
#AHAMOVE_BASE_URL=https://partner-gw.ahamove.com
#AHAMOVE_MOCK_FAST=1        # TEST-ONLY: mock timeline tiến tức thì (E2E 05-nvc-api precondition)

# --- PWA push + analytics (SF-23 — dual-mode: điền key → thật, trống → mock/off) ---
# FE (BUILD-TIME — thay đổi phải REBUILD image web: docker compose up --build web):
#VITE_ONESIGNAL_APP_ID=     # OneSignal app id (FE SDK init)
#VITE_GA_MEASUREMENT_ID=    # GA4 G-XXXXXXX
# BFF (RUNTIME — chỉ restart bff, không rebuild):
#ONESIGNAL_APP_ID=          # OneSignal app id (REST API body)
#ONESIGNAL_REST_API_KEY=    # REST API key — local-only, KHÔNG commit

# --- Kafka event bus (SF-27) — side-channel best-effort; mặc định OFF ---
# Flag chỉ nhận đúng chữ 'true' (thống nhất Go/Java/BFF/e2e — review SF-27).
# true → cần kafka chạy: docker compose --profile kafka up -d kafka kafka-init kafka-ui
# ENV PRECEDENCE (run.sh Go source .env set -a → .env overwrite shell export):
# .env là nguồn chính khi bật; shell export chỉ cần bổ sung cho Java (BFF tự đọc
# root .env qua dotenv; Go run.sh source .env).
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- SF-26 — webhook nhận đơn từ sàn (FI-271) ---
WEBHOOK_HMAC_SECRET=dev-webhook-secret-change-me
# optional — override tên field payload (flat rename map, JSON):
#WEBHOOK_MAPPING={"externalId":"orderNumber","codAmount":"amountDue"}
# optional — Java: claim stale reclaim threshold (giây, mặc định 120)
#WEBHOOK_CLAIM_STALE_SECONDS=120
