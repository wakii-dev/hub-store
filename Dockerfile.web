# Shell + 2 remotes static build (context = REPO ROOT) — SF-11 compose mẫu.
# Build lại federation từ đầu (turbo cache TẮT không áp dụng trong Docker —
# mỗi image build sạch; remoteEntry prod ở dist root theo SPIKE 1).
# Remotes trỏ URL tương đối /remotes/<name>/remoteEntry.js (nginx phục vụ),
# API qua cùng origin /api (proxy → bff:8080) — không CORS trong compose.
FROM node:22-alpine AS fe-build
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY remotes.config.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api-client/package.json packages/api-client/
COPY apps/shell/package.json apps/shell/
COPY apps/orders/package.json apps/orders/
COPY apps/fulfillment/package.json apps/fulfillment/
COPY services/bff-gateway/package.json services/bff-gateway/
COPY e2e/package.json e2e/
RUN pnpm install --frozen-lockfile
COPY . .
# Remotes phục vụ dưới /remotes/<name>/ — URL tương đối + vite --base khớp
RUN node -e "const fs=require('fs');const f='remotes.config.json';const j=JSON.parse(fs.readFileSync(f));j.orders.url='/remotes/orders/remoteEntry.js';j.fulfillment.url='/remotes/fulfillment/remoteEntry.js';fs.writeFileSync(f,JSON.stringify(j,null,2))"
ENV VITE_API_BASE_URL=/api
# SF-23: Vite nhúng biến VITE_* lúc BUILD-TIME — build args trống = off-mode
ARG VITE_ONESIGNAL_APP_ID
ARG VITE_GA_MEASUREMENT_ID
ENV VITE_ONESIGNAL_APP_ID=$VITE_ONESIGNAL_APP_ID \
    VITE_GA_MEASUREMENT_ID=$VITE_GA_MEASUREMENT_ID
RUN pnpm build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=fe-build /repo/apps/shell/dist /usr/share/nginx/html
COPY --from=fe-build /repo/apps/orders/dist /remotes/orders
COPY --from=fe-build /repo/apps/fulfillment/dist /remotes/fulfillment
EXPOSE 3000
